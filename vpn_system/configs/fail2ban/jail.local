[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
bantime  = 3600
findtime  = 600
maxretry = 3

[sshd]
enabled = true
port    = ssh
logpath = %(sshd_log)s
backend = %(sshd_backend)s

[nginx-http-auth]
enabled = true

# Xray runs behind Nginx and typically logs only 127.0.0.1.
# Use Nginx access log to ban abusive clients hitting invalid endpoints (4xx/5xx).
[xray-access]
enabled = true
port    = http,https
filter  = nginx-vortex-xray
logpath = /var/log/nginx/access.log
maxretry = 20
findtime = 300
bantime = 3600
